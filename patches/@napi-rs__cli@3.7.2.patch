+  } finally {
+    try {
+      if (
+        await reconciliationReclaimIsOwnedBy(
+          identity,
+          reclaimPath,
+          reclaimStats,
+          token,
+        )
+      ) {
+        await retireReconciliationPathIfMatches(
+          identity,
+          reclaimPath,
+          reclaimStats,
+          async (retiredPath) => {
+            try {
+              const owner = JSON.parse(
+                await readFile(retiredPath, 'utf8'),
+              ) as ReconciliationReclaimOwner
+              return (
+                isReconciliationReclaimOwner(
+                  owner,
+                  identity.key,
+                  reclaimPath,
+                ) && owner.token === token
+              )
+            } catch {
+              return false
+            }
+          },
+        )
