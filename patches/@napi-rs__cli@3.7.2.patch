+          identity,
+          reconciliationCandidatePath(reclaimPath, token),
+          reclaimStats,
+        )
+      }
+    } catch (cleanupError) {
+      if (!isReconciliationAnchorChangedError(cleanupError)) {
+        debug.warn(
+          `Failed to release filesystem reconciliation reclaim guard: ${errorMessage(cleanupError)}`,
+        )
+      }
+    }
+  }
