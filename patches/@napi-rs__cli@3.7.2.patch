+  const path = resolveFileSystemTransactionRelativePath(
+    root,
+    entry.path,
+    'Transaction path',
+  )
+  const expectedParent = resolveFileSystemTransactionRelativePath(
+    root,
+    entry.parent.canonicalParent,
+    'Transaction canonical parent',
+    true,
+  )
